// Fallout 4 Pip-Boy terminal aesthetic
$color-background = #0b0e07
$color-footer-mobile-1 = lighten($color-background, 2%)
$color-footer-mobile-2 = lighten($color-background, 8%)
$color-background-code = lighten($color-background, 3%)
$color-border = #1a3a12
$color-scrollbar = #14862a
$color-meta = #0fa82a
$color-meta-code = #0fa82a
$color-link = rgba(20, 254, 23, 0.8)
$color-text = #14fe17
$color-accent-3 = #0fa82a
$color-accent-2 = #12d922
$color-accent-1 = #14fe17
$color-quote = #18ff1c
$highlight = hexo-config("highlight") || "rainbow"
